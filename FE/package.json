{
  "name": "fishnote-fe",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/export-prerender-catalog.mjs --check && tsc -b && vite build && node scripts/prerender.mjs",
    "build:ci": "bash ../scripts/ci/run-with-timeout.sh 180 -- npm run build",
    "lint": "eslint .",
    "lint:ci": "bash ../scripts/ci/run-with-timeout.sh 180 -- npm run lint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:prerender": "node --test scripts/prerender.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "npm run build:ci && npm run test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:operational": "playwright test --config=playwright.operational.config.ts",
    "test:a11y": "npm run build:ci && npm run test:a11y:run",
    "test:a11y:run": "playwright test e2e/a11y.spec.ts",
    "check": "npm run lint:ci && npm run test && npm run build:ci && npm run test:prerender && npm run test:e2e:run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.7.9",
    "lucide-react": "^0.468.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.2",
    "playwright": "^1.54.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
